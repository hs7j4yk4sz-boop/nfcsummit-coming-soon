{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data/**",
              "components/dragons/**",
              "components/layout/**",
              "components/photo/**",
              "components/type/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Space Grotesk|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Anton, Space Grotesk, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|thickness|top|style|key|ref|className|style|children)$/]",
        "message": "<AccentBand> doesn't accept that prop. Declared props: color, thickness, top, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|leading|color|glitch|as|style|key|ref|className|style|children)$/]",
        "message": "<DisplayTitle> doesn't accept that prop. Declared props: children, size, leading, color, glitch, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='leading'] > Literal[value!=/^(?:tight|normal|loose)$/]",
        "message": "<DisplayTitle> leading must be one of 'tight' | 'normal' | 'loose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|div)$/]",
        "message": "<DisplayTitle> as must be one of 'h1' | 'h2' | 'h3' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DragonFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|crop|accentLine|base|background|style|children|key|ref|className|style|children)$/]",
        "message": "<DragonFrame> doesn't accept that prop. Declared props: id, crop, accentLine, base, background, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DragonFrame'] > JSXAttribute[name.name='id'] > Literal[value!=/^(?:01|02|03|04|05|06|07|08)$/]",
        "message": "<DragonFrame> id must be one of '01' | '02' | '03' | '04' | '05' | '06' | '07' | '08'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DragonFrame'] > JSXAttribute[name.name='crop'] > Literal[value!=/^(?:full|head|offframe|bust)$/]",
        "message": "<DragonFrame> crop must be one of 'full' | 'head' | 'offframe' | 'bust'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GhostNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|style|key|ref|className|style|children)$/]",
        "message": "<GhostNumber> doesn't accept that prop. Declared props: children, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradedPhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|mode|scanlines|protect|objectPosition|style|children|key|ref|className|style|children)$/]",
        "message": "<GradedPhoto> doesn't accept that prop. Declared props: src, alt, mode, scanlines, protect, objectPosition, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradedPhoto'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:color|bw)$/]",
        "message": "<GradedPhoto> mode must be one of 'color' | 'bw'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradedPhoto'] > JSXAttribute[name.name='protect'] > Literal[value!=/^(?:none|bottom|left)$/]",
        "message": "<GradedPhoto> protect must be one of 'none' | 'bottom' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lead'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|measure|style|key|ref|className|style|children)$/]",
        "message": "<Lead> doesn't accept that prop. Declared props: children, size, color, measure, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lead'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lead|body)$/]",
        "message": "<Lead> size must be one of 'lead' | 'body'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tracking|color|as|style|key|ref|className|style|children)$/]",
        "message": "<MonoLabel> doesn't accept that prop. Declared props: children, size, tracking, color, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoLabel'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|div|p)$/]",
        "message": "<MonoLabel> as must be one of 'span' | 'div' | 'p'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|detail|emphasis|style|key|ref|className|style|children)$/]",
        "message": "<PriceRow> doesn't accept that prop. Declared props: label, value, detail, emphasis, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|accent|color|size|style|key|ref|className|style|children)$/]",
        "message": "<QuoteBlock> doesn't accept that prop. Declared props: children, attribution, accent, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|eyebrow|eyebrowRight|footerLeft|footerRight|bleed|width|height|children|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: surface, eyebrow, eyebrowRight, footerLeft, footerRight, bleed, width, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:ink|concrete)$/]",
        "message": "<SlideFrame> surface must be one of 'ink' | 'concrete'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|unit|accent|color|size|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, unit, accent, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|poster|protect|scanlines|style|children|key|ref|className|style|children)$/]",
        "message": "<VideoBackdrop> doesn't accept that prop. Declared props: src, poster, protect, scanlines, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoBackdrop'] > JSXAttribute[name.name='protect'] > Literal[value!=/^(?:none|bottom|left)$/]",
        "message": "<VideoBackdrop> protect must be one of 'none' | 'bottom' | 'left'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
